# ── Copy to .env for local dev (never commit .env). ──────────────────────────

# PostgreSQL connection string.
#  - On Railway: add a PostgreSQL plugin, then set a reference variable
#      DATABASE_URL = ${{Postgres.DATABASE_URL}}
#  - Locally: point at your own Postgres, e.g.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/horizon

# Port (Railway injects PORT automatically; default 3000).
PORT=3000

# Force SSL on the DB connection. Leave unset on Railway's private network.
# Set to "true" for a public Postgres URL, "false" to force off.
# PGSSL=true

# Owner email — seeded as the first digest recipient on first boot.
OWNER_EMAIL=sachinganeshan14@gmail.com

# ── Optional: daily-agent intelligence (discovery + write-ups). ──────────────
# Set ONE of these to enable live web research in the discovery agent.
# Without a key, trajectory / scoring / digest still run.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# HORIZON_MODEL=claude-3-5-sonnet-latest   # or gpt-4o-mini

# ── Optional: email delivery for the daily digest (SMTP). ────────────────────
# Works with Gmail (app password), SendGrid, Resend, Postmark, etc.
# Without these, the digest is generated & stored but not emailed.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM=Horizon <you@gmail.com>
